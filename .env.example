# ---------------------------------------------------------------
# این فایل را به .env کپی کنید و مقادیر را تغییر دهید
#   cp .env.example .env
# ---------------------------------------------------------------

# کلید امنیتی — روی سرور حتماً عوض کنید
# تولید مقدار تصادفی:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=dev-insecure-key-please-change-on-server

# روی سرور حتماً 0
DEBUG=1

# دامنه‌ها، جدا شده با کاما
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# کوکی فقط-HTTPS.
#   0 = سایت روی HTTP بالا می‌آید (فعلاً)
#   1 = بعد از نصب SSL حتماً به 1 تغییر دهید
# اگر روی HTTP این را 1 بگذارید، ورود بدون هیچ پیام خطایی کار نمی‌کند.
SECURE_COOKIES=0

# ---------------------------------------------------------------
# دیتابیس: sqlite (پیش‌فرض، برای تست سریع) یا mysql
# ---------------------------------------------------------------
DB_ENGINE=sqlite

DB_NAME=payroll
DB_USER=payroll
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
